#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")"

SUDO=""
if [ "$(id -u)" -ne 0 ]; then
  command -v sudo >/dev/null 2>&1 || { echo "需要 sudo 权限" >&2; exit 1; }
  SUDO="sudo"
fi
COMPOSE="$SUDO docker compose"

case "${1:-help}" in
  start)   $COMPOSE up -d ;;
  stop)    $COMPOSE down ;;
  restart) $COMPOSE up -d --force-recreate ;;
  status)
    $COMPOSE ps
    echo
    health="$($SUDO docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' hugow-opc 2>/dev/null || true)"
    echo "健康状态：${health:-unknown}"
    ;;
  logs)    $COMPOSE logs -f --tail=100 ;;
  upgrade)
    image="$(grep '^HUGOW_IMAGE=' .env 2>/dev/null | cut -d= -f2 || true)"
    force_image=0
    if [ "${2:-}" = "--image" ]; then
      force_image=1
    fi
    # 镜像模式（install.sh --image）只拉新镜像，不在本机构建；
    # 源码模式仍先 git pull，再重建。
    if [ "$force_image" -eq 1 ] || { [ -n "$image" ] && [ "${image##*:}" != "local" ]; }; then
      $COMPOSE pull
      $COMPOSE up -d --no-build
    else
      git pull --ff-only
      $COMPOSE up -d --build
    fi
    ;;
  backup)
    mkdir -p backups
    stamp="$(date +%Y%m%d-%H%M%S)"
    data_dir="$(grep '^HUGOW_DATA_DIR=' .env 2>/dev/null | cut -d= -f2)"
    data_dir="${data_dir:-./data}"
    if [ -d "$data_dir" ]; then
      tar -czf "backups/hugow-data-${stamp}.tar.gz" "$data_dir"
      echo "已备份：backups/hugow-data-${stamp}.tar.gz"
    else
      echo "没有 ${data_dir} 目录，跳过" >&2
    fi
    ;;
  help|*)
    cat <<'EOF'
用法：./hugow <命令>

  start      启动
  stop       停止
  restart    重启
  status     查看容器与健康状态
  logs       实时日志
  upgrade    拉取新版本并重启；镜像模式自动 pull，源码模式 git pull + 重建
             ./hugow upgrade --image  强制按镜像模式升级
  backup     备份 data/ 快照目录
EOF
    ;;
esac
