# ------------------------------------------------------------------
# HugoW 网关环境变量模板
# 用法：复制到 /etc/hugow/gateway.env，chmod 600，再填真实值。
# 该文件只允许 root 读；服务进程由 systemd 以 hugow 用户运行，
# systemd 会在降权前读取 EnvironmentFile，因此 600 不影响启动。
# ------------------------------------------------------------------

# 必填：飞书企业自建应用（OPC-site-gateway）
FEISHU_APP_ID=cli_________________
FEISHU_APP_SECRET=CHANGE_ME_APP_SECRET

# 必填：Base 的 app_token（多维表格 URL 中 /base/ 后那段）
BITABLE_APP_TOKEN=CHANGE_ME_BITABLE_APP_TOKEN

# 必填：管理员 open_id，逗号或空格分隔；只允许这些人登录工作台
ADMIN_OPEN_IDS=ou_________________

# 必填：会话签名密钥，至少 16 字符；生成命令：
#   openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM

# 可选：会话有效期，默认 12 小时
SESSION_TTL_MS=43200000

# 网关监听：只监听回环，公网只经 Nginx 进来
HOST=127.0.0.1
PORT=8787

# 快照目录：必须与 Nginx 的 /data/ alias 指向同一个目录
DATA_DIR=/srv/hugow/data

# 生产域名：两个子域必须与 DNS、证书、飞书重定向 URL 完全一致
PUBLIC_GATEWAY_ORIGIN=https://admin.hugogoodidea.com
PUBLIC_ADMIN_ORIGIN=https://admin.hugogoodidea.com
FEISHU_REDIRECT_URI=https://admin.hugogoodidea.com/api/auth/callback
FEISHU_OAUTH_SCOPE=auth:user.id:read

# 生产必须 true；只有本地 http 联调才设 false
COOKIE_SECURE=true

# 一般不用改
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_ACCOUNTS_BASE_URL=https://accounts.feishu.cn
