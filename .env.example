# ------------------------------------------------------------------
# OPC 个人站 · 一体化部署配置
# 首次安装：把本文件复制为 .env，按下面注释填写。
# 脚本 install.sh 会自动生成本文件并生成 SESSION_SECRET。
# ------------------------------------------------------------------

# 1) 飞书企业自建应用（开放平台 → 创建应用 → 凭证与基础信息）
FEISHU_APP_ID=CHANGE_ME_FEISHU_APP_ID
FEISHU_APP_SECRET=CHANGE_ME_FEISHU_APP_SECRET

# 2) 多维表格 Base 的 app_token（Base URL 中 /base/ 后那段）
BITABLE_APP_TOKEN=CHANGE_ME_BITABLE_APP_TOKEN

# 2.1) 可选：直接注入 Base access token（user_access_token 或 tenant_access_token）。
#      留空 = 用上面的 App ID/Secret 换 tenant token；个人账号无企业租户时通常拿不到 tenant token，
#      可改由用户身份 OAuth 或企业管理员预置 token。token 只放服务端，绝不进前端。
FEISHU_BASE_ACCESS_TOKEN=

# 2.2) Base 同步策略：required=12 表必须全成才切快照；best-effort=Base 失败仍发布站点快照；
#      off=只发快照。生产建议 required；Base 凭据未就绪、站点要先上线时可临时 best-effort。
FEISHU_BASE_SYNC=required

# 3) 管理员 open_id，多个用逗号分隔；只允许这些人登录工作台
ADMIN_OPEN_IDS=CHANGE_ME_ADMIN_OPEN_ID

# 3.1) 可选：部署令牌登录。仅用于 OAuth 未就绪时的临时运维入口；
#      OAuth 可用后请置空（登录页不会再展示该入口）。至少 16 字符。
ADMIN_BOOTSTRAP_TOKEN=

# 3.2) 管理员账号密码登录（备用入口）。密码留空=关闭该入口；至少 10 字符。
ADMIN_LOGIN_USER=admin
ADMIN_LOGIN_PASSWORD=
# 账号密码登录后在侧栏显示的姓名
ADMIN_DISPLAY_NAME=HugoW

# 3.3) 是否启用飞书 OAuth。企业租户就绪后保持 1；
#      登录页默认展示飞书扫码，读不到二维码时可切到账号密码。
FEISHU_OAUTH_ENABLED=1

# 4) 会话签名密钥：install.sh 会自动生成；也可用 openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM

# 本地第一次跑通：保持 1，不校验飞书凭据；只提供访客站和工作台外壳。
# 填完 1~4 项后改成 0，重启即可使用真实飞书登录与发布。
HUGOW_DEMO=1

# 端口与数据目录
HUGOW_WWW_PORT=8080
HUGOW_ADMIN_PORT=8081
HUGOW_DATA_DIR=./data
HUGOW_IMAGE=ghcr.io/hugoworld/opc-site:local

# 对外访问地址。install.sh 在真实登录模式下会按服务器公网 IP 自动填；
# 绑定 HTTPS 域名后，把下面三行改成同一个域名，并让飞书回调与它完全一致。
PUBLIC_GATEWAY_ORIGIN=http://127.0.0.1:8081
PUBLIC_ADMIN_ORIGIN=http://127.0.0.1:8081
FEISHU_REDIRECT_URI=http://127.0.0.1:8081/api/auth/callback
COOKIE_SECURE=false

# 一般不用改
FEISHU_OAUTH_SCOPE=auth:user.id:read
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_ACCOUNTS_BASE_URL=https://accounts.feishu.cn
