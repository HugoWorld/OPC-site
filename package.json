{
  "name": "prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:copy": "node scripts/check-copy.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:schema": "node --experimental-strip-types scripts/test-schema.ts",
    "test:gateway": "node --experimental-strip-types scripts/test-gateway.ts",
    "test:migration": "node --experimental-strip-types scripts/test-migration.ts",
    "verify": "npm run build && npm run test:schema && npm run test:gateway && npm run test:migration && npm run check:copy && npm run check:assets && npm run smoke",
    "shadcn": "npx --yes shadcn@latest"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.1",
    "lucide-react": "^0.469.0",
    "motion": "^12.0.0",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.65.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
